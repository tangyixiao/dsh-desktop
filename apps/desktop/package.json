{
  "name": "@deepseek-ai/dsh-desktop",
  "version": "0.1.2-alpha.1",
  "private": true,
  "type": "module",
  "main": "lib/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dist": "pnpm build && electron-builder --config electron-builder.yml"
  },
  "dependencies": {
    "electron": "^37.2.6"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "electron-builder": "^26.0.12",
    "typescript": "^6.0.3"
  },
  "build": {
    "appId": "ai.deepseek.dsh",
    "productName": "DSH Desktop",
    "artifactName": "dsh-desktop-${version}-${arch}.${ext}"
  }
